---
import { links } from "~/data/links";
---

<section class="hero container">
  <h1>
    Who's listening<br />on <span class="mark">:3000</span>?
  </h1>
  <p class="lede">
    <em>Qui</em> <span class="say" title="Pronounced “kee”">/ki/</span>, French for “who”, is a Raycast extension that shows every listening port, what's behind it and why it's running.
    Then frees it in one keystroke.
  </p>
  <div class="ctas">
    <a class="btn btn-primary" href={links.store} target="_blank" rel="noopener">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M12 4v11m0 0-4.5-4.5M12 15l4.5-4.5M5 20h14"></path>
      </svg>
      Add to Raycast
    </a>
    <a class="btn btn-secondary" href={links.github} target="_blank" rel="noopener">
      <span>Free & open source</span>
      <span class="pill">MIT</span>
    </a>
  </div>
</section>

<style>
  .hero {
    padding: 72px 0 56px;
    text-align: center;
  }

  h1 {
    margin: 0;
    font-size: clamp(56px, 11vw, 116px);
    font-weight: 800;
    font-stretch: var(--condensed);
    line-height: 0.98;
  }

  .mark {
    position: relative;
    z-index: 0;
    font-variant-numeric: tabular-nums;
  }

  .mark::after {
    content: "";
    position: absolute;
    z-index: -1;
    inset: 52% -0.08em 2% -0.06em;
    background: var(--mark);
    transform: skewX(-6deg);
  }

  .lede {
    max-width: 560px;
    margin: 28px auto 0;
    color: var(--ink-soft);
    font-size: 19px;
    font-weight: 500;
  }

  .say {
    color: var(--ink-faint);
    font-weight: 400;
    white-space: nowrap;
  }

  .ctas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 14px;
    margin-top: 36px;
  }

  .pill {
    padding: 2px 8px;
    border-radius: 7px;
    background: var(--ink);
    color: var(--bg);
    font-size: 13px;
  }
</style>

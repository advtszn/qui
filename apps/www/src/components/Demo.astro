---
import { demoPorts } from "~/data/demo";

const first = demoPorts[0];
---

<section class="demo-wrap container" aria-label="Interactive demo">
  <div class="window" id="demo" tabindex="0">
    <div class="search">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
        <circle cx="11" cy="11" r="6.5"></circle><path d="m16 16 4 4"></path>
      </svg>
      <input id="demo-search" type="text" placeholder="Filter by port, process, project or PID" autocomplete="off" spellcheck="false" aria-label="Filter ports" />
    </div>

    <div class="body">
      <ul class="list" id="demo-list" role="listbox" aria-label="Listening ports">
        {
          demoPorts.map((p, i) => (
            <li
              class:list={["row", { selected: i === 0 }]}
              role="option"
              aria-selected={i === 0 ? "true" : "false"}
              data-port={p.port}
              data-search={[p.port, p.process, p.pid, p.framework, p.runtime, p.project].filter(Boolean).join(" ").toLowerCase()}
            >
              <img src={p.icon} alt="" width="18" height="18" />
              <span class="port">{p.port}</span>
              <span class="proc">{p.process}</span>
            </li>
          ))
        }
      </ul>
      <div class="empty" id="demo-empty" hidden>
        <p>No listening ports</p>
        <button type="button" id="demo-reset">Restart the demo</button>
      </div>

      <div class="detail" id="demo-detail">
        <pre class="cmd" data-field="command">{first.command}</pre>
        <dl class="meta">
          <div><dt>Port</dt><dd data-field="port">{first.port}/TCP</dd></div>
          <div><dt>Bound To</dt><dd><span class="tag" data-field="bound">{first.bound}</span></dd></div>
          <div class="sep"></div>
          <div data-row="framework"><dt>Framework</dt><dd><img data-field="frameworkIcon" src={first.icon} alt="" width="14" height="14" /><span data-field="framework">{first.framework}</span></dd></div>
          <div><dt>Runtime</dt><dd><img data-field="runtimeIcon" src={first.runtimeIcon} alt="" width="14" height="14" /><span data-field="runtime">{first.runtime}</span></dd></div>
          <div><dt>PID</dt><dd data-field="pid">{first.pid}</dd></div>
          <div><dt>Started</dt><dd data-field="uptime">{first.uptime} ago</dd></div>
          <div><dt>Memory</dt><dd data-field="memory">{first.memory}</dd></div>
          <div class="sep"></div>
          <div><dt>Working Directory</dt><dd data-field="cwd">{first.cwd}</dd></div>
          <div data-row="git"><dt>Git</dt><dd data-field="git">{first.project} @ {first.branch}</dd></div>
          <div><dt>Started By</dt><dd data-field="chain">{first.chain.join(" → ")}</dd></div>
        </dl>
      </div>
    </div>

    <div class="bar">
      <div class="bar-title">
        <img src="/icon.png" alt="" width="18" height="18" />
        <span>Manage Ports</span>
      </div>
      <div class="toast" id="demo-toast" role="status" aria-live="polite"></div>
      <div class="bar-actions">
        <button type="button" class="action" id="demo-kill">Terminate <kbd>⌃</kbd><kbd>X</kbd></button>
        <span class="divider"></span>
        <span class="action muted">Actions <kbd>⌘</kbd><kbd>K</kbd></span>
      </div>
    </div>
  </div>

  <p class="hint">
    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M5 3l14 8-6 1.5L10 19z"></path></svg>
    Psst… it's interactive. Try <kbd>↑</kbd> <kbd>↓</kbd>, type to filter, or <kbd>⌃</kbd><kbd>X</kbd> to free a port.
  </p>
</section>

<script type="application/json" id="demo-data" set:html={JSON.stringify(demoPorts)} />

<script>
  import type { DemoPort } from "~/data/demo";

  const ports: DemoPort[] = JSON.parse(document.getElementById("demo-data")!.textContent!);
  const root = document.getElementById("demo")!;
  const list = document.getElementById("demo-list")!;
  const empty = document.getElementById("demo-empty")!;
  const detail = document.getElementById("demo-detail")!;
  const search = document.getElementById("demo-search") as HTMLInputElement;
  const toast = document.getElementById("demo-toast")!;
  const killBtn = document.getElementById("demo-kill")!;
  const resetBtn = document.getElementById("demo-reset")!;

  const rows = () => [...list.querySelectorAll<HTMLLIElement>(".row:not(.gone):not(.filtered)")];
  const field = (name: string) => detail.querySelector<HTMLElement>(`[data-field="${name}"]`)!;
  const showRow = (name: string, visible: boolean) =>
    detail.querySelector<HTMLElement>(`[data-row="${name}"]`)!.toggleAttribute("hidden", !visible);

  function render(port: DemoPort | undefined) {
    detail.toggleAttribute("hidden", !port);
    if (!port) return;
    field("command").textContent = port.command;
    field("port").textContent = `${port.port}/TCP`;
    field("bound").textContent = port.bound;
    showRow("framework", Boolean(port.framework));
    if (port.framework) {
      field("framework").textContent = port.framework;
      (field("frameworkIcon") as HTMLImageElement).src = port.icon;
    }
    field("runtime").textContent = port.runtime;
    (field("runtimeIcon") as HTMLImageElement).src = port.runtimeIcon;
    field("pid").textContent = String(port.pid);
    field("uptime").textContent = `${port.uptime} ago`;
    field("memory").textContent = port.memory;
    field("cwd").textContent = port.cwd;
    showRow("git", Boolean(port.project));
    field("git").textContent = port.project ? `${port.project} @ ${port.branch}` : "";
    field("chain").textContent = [...port.chain, port.process].join(" → ");
  }

  function select(row: HTMLLIElement | undefined) {
    for (const r of list.querySelectorAll(".row")) {
      r.classList.remove("selected");
      r.setAttribute("aria-selected", "false");
    }
    row?.classList.add("selected");
    row?.setAttribute("aria-selected", "true");
    row?.scrollIntoView({ block: "nearest" });
    render(ports.find((p) => String(p.port) === row?.dataset.port));
    const none = rows().length === 0;
    empty.hidden = !none;
    list.hidden = none;
  }

  const selected = () => list.querySelector<HTMLLIElement>(".row.selected:not(.gone):not(.filtered)") ?? undefined;

  function move(delta: number) {
    const visible = rows();
    if (visible.length === 0) return;
    const current = selected();
    const index = current ? visible.indexOf(current) : -1;
    select(visible[Math.min(visible.length - 1, Math.max(0, index + delta))]);
  }

  let toastTimer: number | undefined;
  function showToast(html: string) {
    toast.innerHTML = html;
    toast.classList.add("visible");
    clearTimeout(toastTimer);
    toastTimer = window.setTimeout(() => toast.classList.remove("visible"), 2600);
  }

  function terminate() {
    const row = selected();
    if (!row) return;
    const port = ports.find((p) => String(p.port) === row.dataset.port)!;
    const visible = rows();
    const next = visible[visible.indexOf(row) + 1] ?? visible[visible.indexOf(row) - 1];
    row.classList.add("gone");
    select(next);
    showToast(`<span class="dot"></span><b>Freed port ${port.port}</b> ${port.process} (PID ${port.pid}) exited`);
  }

  function reset() {
    for (const r of list.querySelectorAll(".row")) r.classList.remove("gone", "filtered");
    search.value = "";
    select(rows()[0]);
    root.focus();
  }

  search.addEventListener("input", () => {
    const query = search.value.trim().toLowerCase();
    for (const r of list.querySelectorAll<HTMLLIElement>(".row")) {
      r.classList.toggle("filtered", query !== "" && !r.dataset.search!.includes(query));
    }
    if (!selected()) select(rows()[0]);
    else select(selected());
  });

  list.addEventListener("click", (event) => {
    const row = (event.target as HTMLElement).closest<HTMLLIElement>(".row");
    if (row) select(row);
  });

  root.addEventListener("keydown", (event) => {
    if (event.key === "ArrowDown" || event.key === "ArrowUp") {
      event.preventDefault();
      move(event.key === "ArrowDown" ? 1 : -1);
    } else if (event.ctrlKey && event.key.toLowerCase() === "x") {
      event.preventDefault();
      terminate();
    }
  });

  killBtn.addEventListener("click", terminate);
  resetBtn.addEventListener("click", reset);
</script>

<style>
  .demo-wrap {
    padding-bottom: 40px;
  }

  .window {
    --w-bg: #1d1d20;
    --w-line: rgb(255 255 255 / 0.07);
    --w-text: #ececee;
    --w-soft: #8e8e95;

    display: flex;
    flex-direction: column;
    max-width: 880px;
    height: 568px;
    margin-inline: auto;
    overflow: hidden;
    border: 1px solid rgb(255 255 255 / 0.1);
    border-radius: 22px;
    background: var(--w-bg);
    color: var(--w-text);
    box-shadow:
      0 40px 80px -30px var(--shadow),
      0 12px 24px -12px color-mix(in oklab, var(--ink) 30%, transparent);
    font-family: var(--system);
    font-size: 14px;
    outline: none;
  }

  .window:focus-visible {
    box-shadow:
      0 0 0 3px var(--mark),
      0 40px 80px -30px var(--shadow);
  }

  .search {
    display: flex;
    align-items: center;
    gap: 12px;
    height: 58px;
    padding: 0 20px;
    border-bottom: 1px solid var(--w-line);
    color: var(--w-soft);
  }

  .search svg {
    width: 18px;
    height: 18px;
    flex: none;
  }

  .search input {
    flex: 1;
    min-width: 0;
    border: 0;
    background: none;
    color: var(--w-text);
    font: inherit;
    font-size: 17px;
    outline: none;
  }

  .search input::placeholder {
    color: #67676d;
  }

  .body {
    display: grid;
    flex: 1;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    min-height: 0;
  }

  .list,
  .empty {
    margin: 0;
    padding: 8px;
    overflow-y: auto;
    border-right: 1px solid var(--w-line);
    list-style: none;
  }

  .row {
    display: flex;
    align-items: center;
    gap: 12px;
    max-height: 44px;
    padding: 10px 12px;
    border-radius: 9px;
    cursor: pointer;
    transition:
      max-height 0.25s ease,
      padding 0.25s ease,
      opacity 0.2s ease,
      transform 0.25s ease;
  }

  .row:hover {
    background: rgb(255 255 255 / 0.04);
  }

  .row.selected {
    background: rgb(255 255 255 / 0.09);
  }

  .row.gone {
    max-height: 0;
    padding-block: 0;
    opacity: 0;
    transform: translateX(-24px);
    pointer-events: none;
  }

  .row.filtered {
    display: none;
  }

  .port {
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .proc {
    overflow: hidden;
    color: var(--w-soft);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px;
    color: var(--w-soft);
  }

  .empty[hidden] {
    display: none;
  }

  .empty button {
    padding: 6px 12px;
    border: 1px solid var(--w-line);
    border-radius: 8px;
    background: rgb(255 255 255 / 0.06);
    color: var(--w-text);
    font: inherit;
    cursor: pointer;
  }

  .detail {
    padding: 18px 22px;
    overflow-y: auto;
  }

  .cmd {
    margin: 0 0 16px;
    padding: 12px 14px;
    border-radius: 9px;
    background: rgb(255 255 255 / 0.05);
    font-family: var(--mono);
    font-size: 12.5px;
    line-height: 1.5;
    white-space: pre-wrap;
    word-break: break-all;
  }

  .meta {
    margin: 0;
  }

  .meta > div:not(.sep) {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 6px 0;
  }

  .meta > div[hidden] {
    display: none;
  }

  .sep {
    height: 1px;
    margin: 6px 0;
    background: var(--w-line);
  }

  dt {
    flex: none;
    color: var(--w-soft);
  }

  dd {
    display: flex;
    align-items: center;
    gap: 6px;
    min-width: 0;
    margin: 0;
    overflow: hidden;
    text-align: right;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .tag {
    padding: 1px 8px;
    border-radius: 6px;
    background: rgb(255 255 255 / 0.08);
    font-size: 12.5px;
  }

  .bar {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 46px;
    padding: 0 12px 0 16px;
    border-top: 1px solid var(--w-line);
    background: rgb(255 255 255 / 0.02);
    color: var(--w-soft);
    font-size: 13px;
  }

  .bar-title {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .bar-title img {
    border-radius: 4px;
  }

  .bar-actions {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .action {
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 5px 8px;
    border: 0;
    border-radius: 7px;
    background: none;
    color: var(--w-text);
    font: inherit;
    font-weight: 500;
    cursor: pointer;
  }

  button.action:hover {
    background: rgb(255 255 255 / 0.07);
  }

  .action.muted {
    color: var(--w-soft);
    cursor: default;
  }

  .action kbd,
  .hint kbd {
    display: inline-grid;
    place-items: center;
    min-width: 20px;
    height: 20px;
    padding: 0 4px;
    border-radius: 5px;
    background: rgb(255 255 255 / 0.1);
    font-size: 11.5px;
  }

  .divider {
    width: 1px;
    height: 16px;
    background: var(--w-line);
  }

  .toast {
    position: absolute;
    inset: 0 auto 0 16px;
    display: flex;
    align-items: center;
    gap: 8px;
    padding-right: 16px;
    background: #222226;
    color: var(--w-soft);
    opacity: 0;
    transform: translateY(6px);
    transition:
      opacity 0.2s ease,
      transform 0.2s ease;
    pointer-events: none;
  }

  .toast.visible {
    opacity: 1;
    transform: none;
  }

  .toast :global(b) {
    color: var(--w-text);
    font-weight: 600;
  }

  .toast :global(.dot) {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 10px var(--accent);
  }

  .hint {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 6px;
    margin: 22px 0 0;
    color: var(--ink-faint);
    font-size: 14px;
    font-weight: 600;
  }

  .hint svg {
    width: 14px;
    height: 14px;
  }

  .hint kbd {
    background: var(--bg-raised);
    color: var(--ink-soft);
  }

  @media (max-width: 720px) {
    .window {
      height: 460px;
    }
    .body {
      grid-template-columns: 1fr;
    }
    .detail {
      display: none;
    }
    .list,
    .empty {
      border-right: 0;
    }
    .bar-title span,
    .divider,
    .action.muted {
      display: none;
    }
  }
</style>

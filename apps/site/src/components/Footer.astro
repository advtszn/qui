---
import { links } from "~/data/links";
---

<section class="closing container">
  <a class="btn btn-primary" href={links.store} target="_blank" rel="noopener">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M12 4v11m0 0-4.5-4.5M12 15l4.5-4.5M5 20h14"></path>
    </svg>
    Add to Raycast
  </a>
  <p class="req">Requires Raycast on macOS</p>
</section>

<footer class="footer">
  <div class="social">
    <a href={links.github} target="_blank" rel="noopener" aria-label="GitHub">
      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path
          d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.89 1.53 2.34 1.09 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.65 0 0 .84-.27 2.75 1.02a9.56 9.56 0 0 1 5 0c1.91-1.29 2.75-1.02 2.75-1.02.55 1.38.2 2.4.1 2.65.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.85v2.74c0 .27.18.58.69.48A10 10 0 0 0 12 2Z"
        ></path>
      </svg>
    </a>
  </div>
  <p class="credits">
    Built on the ideas of <a href="https://github.com/pranshuparmar/witr" target="_blank" rel="noopener">witr</a>. Site
    inspired by <a href="https://tryalcove.com" target="_blank" rel="noopener">Alcove</a>. Logos by{" "}
    <a href="https://simpleicons.org" target="_blank" rel="noopener">Simple Icons</a>.
  </p>
  <div class="wordmark" aria-hidden="true">Qui est là<span class="qmark">?</span></div>
</footer>

<style>
  .closing {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
    padding: 72px 0 96px;
  }

  .req {
    margin: 0;
    color: var(--ink-faint);
    font-size: 14px;
    font-weight: 600;
  }

  .footer {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    overflow: hidden;
  }

  .social a {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 10px;
    background: var(--bg-raised);
    color: var(--ink-soft);
  }

  .social a:hover {
    color: var(--ink);
  }

  .social svg {
    width: 18px;
    height: 18px;
  }

  .credits {
    margin: 0;
    color: var(--ink-faint);
    font-size: 13px;
    font-weight: 500;
  }

  .credits a {
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .wordmark {
    margin-top: 24px;
    margin-bottom: -0.3em;
    background: linear-gradient(to bottom, var(--bg-hover), var(--bg));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    font-size: clamp(80px, 19vw, 240px);
    font-weight: 900;
    font-stretch: var(--condensed);
    line-height: 1;
    letter-spacing: -0.05em;
    word-spacing: 0.18em;
    white-space: nowrap;
    user-select: none;
  }

  /* French puts a thin space before "?"; a margin avoids relying on the font having that glyph. */
  .qmark {
    margin-left: 0.1em;
  }
</style>
